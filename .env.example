# ──────────────────────────────────────────────────────────────────────────────
# PDLC Confluence MCP Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to Git — only commit .env.example.
# ──────────────────────────────────────────────────────────────────────────────

# ── Confluence Credentials ────────────────────────────────────────────────────
# Your Confluence/Atlassian site URL (same as Jira if using Atlassian Cloud)
# Example: https://yoursite.atlassian.net
CONFLUENCE_URL=https://<your-site>.atlassian.net

# Atlassian account email address
CONFLUENCE_USERNAME=your-email@example.com

# Atlassian API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=<your-atlassian-api-token>

# ── Server Port ───────────────────────────────────────────────────────────────
PORT=8080
